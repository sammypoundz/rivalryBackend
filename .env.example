# MongoDB connection string (local or Atlas)
DATABASE_URL="mongodb://localhost:27017/rivalry"
# or Atlas: DATABASE_URL="mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/rivalry?retryWrites=true&w=majority"

PORT=5000
NODE_ENV=development

# Auth
JWT_SECRET=super-secret-change-me
JWT_EXPIRES_IN=7d

# Frontend origin for CORS
CLIENT_URL=http://localhost:5173,https://www.rivalry.com.ng,https://rivalry.com.ng

# KoboPoint (dynamic virtual accounts) — from Dashboard → Settings → API Keys
# Webhook URL to set in the KoboPoint Dashboard:
#   https://<your-render-url>/api/webhooks/kobopoint
KOBOPOINT_SECRET_KEY=
KOBOPOINT_API_KEY=
KOBOPOINT_BUSINESS_ID=
KOBOPOINT_BANK_CODES=100033
